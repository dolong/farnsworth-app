<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Hardened runtime + V8 JIT + executable-memory entitlements (required for Electron + V8) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network: outbound HTTPS (Claude API, Anthropic, Cloudflare, OAuth providers) + local servers (canvas dev server :5173, cloud relay :7778) -->
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>

    <!-- File access: user-selected workspace folder (TCC-protected via Info.plist usage strings) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>